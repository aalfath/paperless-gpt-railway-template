{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT} {
	# Railway health check: no login needed, and it only passes when
	# paperless-gpt itself answers (its /api/version route).
	handle /healthz {
		rewrite * /api/version
		reverse_proxy 127.0.0.1:8081
	}

	# Everything else (web UI and API) needs the generated password.
	handle {
		basic_auth {
			{$ADMIN_USERNAME} {$ADMIN_PASSWORD_HASH}
		}
		reverse_proxy 127.0.0.1:8081 {
			flush_interval -1
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}

	log {
		output stdout
		format console
		level ERROR
	}
}
